{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "feedback-widget",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "feedback-widget.blahim.com", "custom_domain": true}
  ],
  "assets": {
    "directory": "./.cloudflare/widget",
    // setup.html fetches the exact index.html path with redirects disabled.
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
